# =============================================================================
# Vercel project environment variables
#
# These power /api/social-stats. All of them are OPTIONAL — whichever
# credential is missing, the corresponding follower count is returned as null
# and the frontend falls back to its baked-in placeholder. You can roll them
# out one platform at a time.
# =============================================================================

# ── Telegram ──
# Create a bot via @BotFather, then add it as an admin of your channel.
TELEGRAM_BOT_TOKEN=
# Channel username (with leading @) or numeric chat id, e.g. @orakzaibond
TELEGRAM_CHAT_ID=

# ── X (Twitter) ──
# Bearer token from a project on developer.x.com (the v2 user-by-username
# endpoint requires a Basic-tier project; the public-metrics field is included).
X_BEARER_TOKEN=
# Handle without the @, e.g. OrakzaiBond
X_USERNAME=

# ── Facebook ──
# Numeric Page id (Page > About > Page transparency).
FACEBOOK_PAGE_ID=
# Long-lived Page Access Token from Graph API Explorer.
FACEBOOK_PAGE_TOKEN=
