{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm install --frozen-lockfile=false && pnpm --filter @workspace/orakzai-bond build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install -g pnpm@9 && pnpm install --frozen-lockfile=false",
  "framework": null,
  "redirects": [
    {
      "source": "/whitepaper",
      "destination": "/pdfs/whitepaper.pdf",
      "permanent": false
    },
    {
      "source": "/pdf",
      "destination": "/pdfs/marketing.pdf",
      "permanent": false
    },
    {
      "source": "/Auditreport",
      "destination": "/pdfs/audit-report.pdf",
      "permanent": false
    },
    {
      "source": "/auditreport",
      "destination": "/pdfs/audit-report.pdf",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/pdfs/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
