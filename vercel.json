{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,
  "redirects": [
    {
      "source": "/whitepaper",
      "destination": "/pdfs/whitepaper.pdf",
      "permanent": false
    },
    {
      "source": "/pdf",
      "destination": "/pdfs/marketing.pdf",
      "permanent": false
    },
    {
      "source": "/Auditreport",
      "destination": "/pdfs/audit-report.pdf",
      "permanent": false
    },
    {
      "source": "/auditreport",
      "destination": "/pdfs/audit-report.pdf",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/pdfs/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
